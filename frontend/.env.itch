# Config for `npm run build:itch` (vite build --mode itch) -- the variant
# uploaded to itch.io as a zip. Only read in that mode; the normal `npm run
# build` and `npm run dev` never see these.
#
# An itch.io HTML game is static: it runs from
# https://html-classic.itch.zone/html/<id>/ in an iframe, with no nginx of
# ours in front of it to proxy the WebSocket. So unlike every other build,
# this one has to name the deployed backend outright. Both letatel.com and
# dicefight.online serve it (see deploy/nginx/full.conf's server_name) --
# swap the host here if that changes. The /duel prefix and the wss scheme
# have to match the deploy: nginx only proxies /duel/ws/, and a page served
# over https cannot open a plaintext ws:// socket.
VITE_WS_BASE=wss://dicefight.online/duel

# Read by src/main.ts for the handful of things that differ beyond URLs --
# no service worker, no "Play online" button. See the comments there.
VITE_ITCH=true
